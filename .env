# Hardware IDs (Use Device Manager to find these. Keep the '0x' prefix)
VENDOR_ID=0xYOUR_VID_HERE
PRODUCT_ID=0xYOUR_PID_HERE

# Tool Paths
NIRCMD_PATH=C:\Path\To\Your\nircmd.exe

# Audio Devices (Exact names as they appear in the Windows Sound Control Panel)
HEADSET_NAME=Your Headset Name
SPEAKER_NAME=Your Speaker Name